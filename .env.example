# Todas as variáveis são OPCIONAIS e não contêm segredos.
# O projeto não lê um arquivo .env: defina no ambiente do sistema (ex.: $env:WA_MODELO="medium").

# Pasta de dados (sessão, banco, mídia, log). Padrão: %LOCALAPPDATA%\wa-leitor
# WA_DATA=

# Modelo do faster-whisper: small (padrão) | medium (mais preciso, mais pesado)
# WA_MODELO=small

# Limite de download por mídia, em MB (padrão 60)
# WA_MAX_MIDIA_MB=60

# Caminho do ffmpeg, se não estiver no PATH
# WA_FFMPEG=

# Minutos de atraso a partir dos quais um envio programado NÃO sai mais (padrão 30)
# WA_ATRASO_MAX_MIN=30

# Caminho do Claude Code usado pelo agente (padrão: %USERPROFILE%\.local\bin\claude.exe)
# WA_CLAUDE=
